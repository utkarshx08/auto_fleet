# ============================================================================
# AUTRAIL FLEET MANAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and populate with your own credentials
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Supabase Cloud PostgreSQL & Realtime Credentials (Required for Live DB)
# Sign up free at https://supabase.com -> New Project -> Project Settings -> API
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# ----------------------------------------------------------------------------
# 2. GPS Telemetry Gateway Security Token
# Used to authenticate IoT / mobile tracker pings to POST /api/tracking/location
# ----------------------------------------------------------------------------
VITE_TELEMETRY_API_KEY=autrail-telemetry-demo-key-2025

# ----------------------------------------------------------------------------
# 3. Optional Geocoding & Mapping Services (Defaults to Free OSM / Carto)
# - Nominatim OpenStreetMap (Free, preconfigured in src/services/geocodingService.js)
# - Carto Dark Matter Tiles (Free, preconfigured in InteractiveTrackingMap.jsx)
# - Mapbox Token (Optional, only if using Mapbox vector tiles or custom styles):
# VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSI...
# ----------------------------------------------------------------------------

