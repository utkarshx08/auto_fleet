# ============================================================================
# AUTRAIL FLEET MANAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and populate with your own credentials
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Supabase Cloud PostgreSQL & Realtime Credentials (Required for Live DB)
# Sign up free at https://supabase.com -> New Project -> Project Settings -> API
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# ----------------------------------------------------------------------------
# 2. GPS Telemetry Gateway Security Token
# Used to authenticate IoT / mobile tracker pings to POST /api/tracking/location
# ----------------------------------------------------------------------------
VITE_TELEMETRY_API_KEY=autrail-telemetry-demo-key-2025

# ----------------------------------------------------------------------------
# 3. Geocoding & CARTO Basemap Cloud Services
# - CARTO Voyager Navigation Basemaps (Key: cb1_59iy_1_7b11bf1fa89a2915b8c2eb95)
# ----------------------------------------------------------------------------
VITE_CARTO_API_KEY=cb1_59iy_1_7b11bf1fa89a2915b8c2eb95
VITE_CARTO_VOYAGER_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=cb1_59iy_1_7b11bf1fa89a2915b8c2eb95
VITE_CARTO_DARK_URL=https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}.png?key=cb1_59iy_1_7b11bf1fa89a2915b8c2eb95
VITE_CARTO_VECTOR_STYLE=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json?key=cb1_59iy_1_7b11bf1fa89a2915b8c2eb95

